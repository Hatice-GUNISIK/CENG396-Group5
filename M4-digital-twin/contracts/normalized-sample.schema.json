{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:strata:m4:normalized-sample:v1",
  "title": "Proposed M4 internal normalized numeric sample",
  "description": "Internal M4 design only. Does not prescribe M1/M2/M3 wire formats.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "type", "source", "trial_id", "sequence", "channel", "origin", "source_t_ms", "timing_basis", "trial_t_ms", "clock_map_id", "synchronized", "quantity", "unit", "reference_frame", "value", "valid", "confidence", "reason"],
  "properties": {
    "schema_version": {"const": 1},
    "type": {"const": "sample"},
    "source": {"type": "string", "minLength": 1},
    "trial_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "channel": {"type": "string", "minLength": 1},
    "origin": {"enum": ["live", "synthetic", "replay"]},
    "recorded_origin": {"enum": ["live", "synthetic"]},
    "source_t_ms": {"type": "number", "minimum": 0},
    "timing_basis": {"type": "string", "minLength": 1},
    "trial_t_ms": {"type": ["number", "null"], "minimum": 0},
    "clock_map_id": {"type": ["string", "null"], "minLength": 1},
    "synchronized": {"type": "boolean"},
    "quantity": {"enum": ["displacement", "acceleration"]},
    "unit": {"enum": ["mm", "m/s2"]},
    "reference_frame": {"type": "string", "minLength": 1},
    "value": {"type": ["number", "null"]},
    "valid": {"type": "boolean"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "reason": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {"if": {"properties": {"valid": {"const": true}}}, "then": {"properties": {"value": {"type": "number"}}}, "else": {"properties": {"value": {"type": "null"}, "confidence": {"enum": [0, null]}}}},
    {"if": {"properties": {"synchronized": {"const": true}}}, "then": {"properties": {"trial_t_ms": {"type": "number", "minimum": 0}, "clock_map_id": {"type": "string", "minLength": 1}}}, "else": {"properties": {"trial_t_ms": {"type": "null"}, "clock_map_id": {"type": "null"}}}},
    {"if": {"properties": {"quantity": {"const": "displacement"}}}, "then": {"properties": {"unit": {"const": "mm"}}}, "else": {"properties": {"unit": {"const": "m/s2"}}}},
    {"if": {"properties": {"origin": {"const": "replay"}}}, "then": {"required": ["recorded_origin"]}, "else": {"not": {"required": ["recorded_origin"]}}}
  ]
}
